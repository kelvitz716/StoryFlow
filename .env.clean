# Snapchat API Configuration
SNAPCHAT_API_BASE_URL=https://snapstories.netlify.app

# Download Configuration
DOWNLOAD_PATH=./downloads
COOKIE_PATH=./cookies

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_WAIT=2
RETRY_MAX_WAIT=60

# Telegram Bot
# Your current Bot Token: 1234567890:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=1234567890:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MTProto API for large files >50MB (optional)
# Get credentials from https://my.telegram.org
# Your current API ID: 1234567890
# Your current API Hash: ad7d8sns8w9e0e399wj3j
TELEGRAM_API_ID=1234567890
TELEGRAM_API_HASH=ad7d8sns8w9e0e399wj3j

# Mode: cli or telegram
MODE=telegram
