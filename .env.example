# ─────────────────────────────────────────────────────────────────────────────
# StoryFlow — Environment Configuration
# Copy this file to .env and fill in your values.
# IMPORTANT: chmod 600 .env  (startup script does this automatically, but set
#            it now too so the file is never world-readable)
# ─────────────────────────────────────────────────────────────────────────────

# ── Bot identity ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Comma-separated list of numeric Telegram user IDs with admin access.
# Must be numeric (e.g. 123456789) — bot will refuse to start otherwise.
ADMIN_USER_ID=1234567890

# ── Snapchat ──────────────────────────────────────────────────────────────────
# Rate limit for Snapchat scraping (requests per minute, default 30).
MAX_REQUESTS_PER_MINUTE=30

# ── Download paths ────────────────────────────────────────────────────────────
DOWNLOAD_PATH=./downloads
COOKIE_PATH=./cookies

# ── Concurrency limits (item 9) ───────────────────────────────────────────────
# Maximum simultaneous download workers (clamped to 1–10, default 2).
# Reduce to 1–2 on a phone to avoid RAM pressure from Jellyfin / Sonarr / etc.
MAX_CONCURRENT_JOBS=2

# Maximum queued jobs per user (default 5).
MAX_JOBS_PER_USER=5

# ── Downloader limits (item 4) ────────────────────────────────────────────────
# Maximum file size accepted from gallery-dl / yt-dlp (in MB, default 500).
MAX_FILE_SIZE_MB=500

# Wall-clock timeout per download subprocess in seconds (default 600 = 10 min).
DOWNLOAD_TIMEOUT_SECONDS=600

# ── Cookie security (item 8) ──────────────────────────────────────────────────
# Allow the admin's own cookie files to be used as a fallback when a specific
# user has no cookies saved.  Disabled by default to prevent credential sharing.
# Set to "true" only if you intentionally want this behaviour.
ALLOW_ADMIN_COOKIE_FALLBACK=false

# ── MTProto (optional — needed for files >50 MB) ──────────────────────────────
# Get credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=             # Phone number with country code (e.g., +1234567890)
TELEGRAM_SESSION_STRING=           # Pre-generated session string (recommended for headless use)
# To generate a session string: python scripts/generate_session.py

# ── Mode ──────────────────────────────────────────────────────────────────────
MODE=telegram
