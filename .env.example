# Admin Configuration
ADMIN_USER_ID=1234567890

# Snapchat via Apify (crawlerbros/snapchat-user-stories-scraper)
# Get your free API token at: https://console.apify.com/settings/integrations
APIF_TOKEN=your_apify_api_token_here

# Download Configuration
DOWNLOAD_PATH=./downloads
COOKIE_PATH=./cookies

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_WAIT=2
RETRY_MAX_WAIT=60

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# MTProto API for large files >50MB (optional)
# Get credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Mode: cli or telegram
MODE=telegram
